source 'https://rubygems.org'

ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 7.2.3.1', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '>= 1.3.7'
gem 'json', '>= 2.9', '< 2.13'

gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
# Ruby 3.4 moved kconv out of the stdlib into the nkf gem. CFPropertyList
# (pulled in by xcodeproj) still does `require 'kconv'`, so without this
# declaration `bundle exec pod install` dies with LoadError partway through
# generating target support files.
gem 'nkf'
gem 'fastlane'

plugins_path = File.join(File.dirname(__FILE__), 'android', 'fastlane', 'Pluginfile')
eval_gemfile(plugins_path) if File.exist?(plugins_path)
