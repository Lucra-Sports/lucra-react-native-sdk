require 'json'

firebase_app_id = '1:33355554746:android:1ca6c47009c467afdec783'
firebase_service_credentials_file = ENV['FIREBASE_SERVICE_CREDENTIALS_FILE']
package_json_file = '../../package.json'
app_gradle_file = '../app/build.gradle'
sdk_gradle_file = '../../../android/build.gradle'
default_platform(:android)

platform :android do
  lane :build_example do
    gradle(task: 'assemble',
           build_type: 'Release',
           flags: '--no-daemon --console=plain',
           properties: {
             'reactNativeArchitectures' => 'arm64-v8a'
           })
  end

  desc 'Build and distribute Android app'
  lane :distribute do
    update_version_and_build
    firebase_app_distribution(
      app: firebase_app_id,
      groups: "stakeholders",
      release_notes: '-',
      service_credentials_file: firebase_service_credentials_file
    )
  end

  desc 'Post the distributed build to Slack - requires SLACK_URL'
  lane :notify_slack do
    version_name = JSON.parse(File.read(package_json_file))['version']
    version_code = File.read(app_gradle_file)[/versionCode\s+(\d+)/, 1] || 'unknown'
    sdk_version = File.read(sdk_gradle_file)[/com\.lucrasports\.sdk:sdk-core:([^"']+)/, 1] || 'unknown'
    changelog = sh('git log -1 --pretty=%B', log: false).strip
    slack(
      pretext: "📲 React Native Sample Android App Release Candidate #{version_name} (#{version_code}) has been distributed!",
      message: changelog,
      payload: {
        'Download' => 'Go grab it on Firebase App Distribution!',
        'Build Number' => version_code,
        'Version' => version_name,
        'Embedded Lucra SDK Version' => sdk_version
      }
    )
  end

  private_lane :update_version_and_build do
    package_json = JSON.parse(File.read(package_json_file))
    version_name = package_json['version']
    latest_release = firebase_app_distribution_get_latest_release(app: firebase_app_id,
                                                                  service_credentials_file: firebase_service_credentials_file)
    next_release = latest_release[:buildVersion].to_i + 1
    increment_version_code(
      gradle_file_path: './app/build.gradle',
      version_code: next_release
    )
    increment_version_name(
      gradle_file_path: './app/build.gradle',
      version_name: version_name
    )
    gradle(task: 'assemble',
           build_type: 'Release',
           flags: '--no-daemon --console=plain',
           properties: {
             'reactNativeArchitectures' => 'arm64-v8a'
           })
  end
end
