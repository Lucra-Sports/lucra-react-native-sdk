ENV['RCT_NEW_ARCH_ENABLED'] = '1'

source 'https://github.com/Lucra-Sports/lucra-ios-sdk.git'
source 'https://cdn.cocoapods.org/'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# LucraSDK links Sentry's dynamic framework; a static Sentry pod builds but
# fails at launch with `dyld: Library not loaded: @rpath/Sentry.framework/Sentry`.
pre_install do |installer|
  installer.pod_targets.each do |pod|
    next unless pod.name == 'Sentry'
    def pod.build_type
      Pod::BuildType.dynamic_framework
    end
  end
end

target 'LucrasdkExample' do
  config = use_native_modules!
  
  pod "Resolver", :git => "https://github.com/ospfranco/Resolver.git", :branch => "master"
  
  use_react_native!(
    path: config[:reactNativePath],
    app_path: "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # `react_native_post_install` raises the deployment target on pod targets but
    # not on the *resource bundle* targets CocoaPods generates alongside them
    # (the `*_Privacy` / `*_resources` ones). Those keep whatever their podspec
    # declared — 9.0 for PromisesObjC, 11.0 for Sentry and Resolver, 12.x for
    # the Firebase and Google pods — and Xcode 26 rejects anything below 15.0
    # outright, failing the build before a line of app code is compiled.
    installer.target_installation_results.pod_target_installation_results.each do |_, result|
      result.resource_bundle_targets.each do |bundle_target|
        bundle_target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end

    # fmt 11.0.2 (via RCT-Folly / RN 0.79) fails to compile under newer Clang
    # (Xcode 16.3+/26) with "call to consteval function ... is not a constant
    # expression". fmt/base.h recomputes FMT_USE_CONSTEVAL from compiler feature
    # macros with no #ifndef guard, so a -D override is ignored; force it off in
    # the pod source instead. Re-applies on every `pod install`.
    fmt_base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_h)
      contents = File.read(fmt_base_h)
      patched = contents.gsub('define FMT_USE_CONSTEVAL 1', 'define FMT_USE_CONSTEVAL 0')
      if patched != contents
        File.write(fmt_base_h, patched)
        Pod::UI.puts '[Lucra] Patched fmt/base.h to disable FMT_USE_CONSTEVAL (Xcode/Clang consteval workaround)'
      end
    end
  end
end
